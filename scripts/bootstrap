#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG_PATH="${AVARCH_CONFIG:-avarch.toml}"
BOOTSTRAP_DIR="${AVARCH_BOOTSTRAP_DIR:-$ROOT_DIR/.avarch/bootstrap}"
BOOTSTRAP_LIB_DIR="$BOOTSTRAP_DIR/lib"
BOOTSTRAP_BIN_DIR="$BOOTSTRAP_DIR/bin"
AV1AN_VERSION_REQ="${AVARCH_AV1AN_VERSION_REQ:->=0.5,<0.6}"

cd "$ROOT_DIR"

say() {
  printf '\n==> %s\n' "$*"
}

pass() {
  printf 'PASS %-10s %s\n' "$1" "$2"
}

miss() {
  printf 'MISS %-10s %s\n' "$1" "$2"
}

warn() {
  printf 'WARN %-10s %s\n' "$1" "$2"
}

run_or_show_output() {
  local output
  if ! output="$("$@" 2>&1)"; then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

prepend_path_once() {
  local dir="$1"
  if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
    export PATH="$dir:$PATH"
  fi
}

prepend_colon_env_once() {
  local name="$1"
  local dir="$2"
  local current="${!name:-}"

  if [[ -z "$current" ]]; then
    export "$name=$dir"
    return
  fi
  if [[ ":$current:" != *":$dir:"* ]]; then
    export "$name=$dir:$current"
  fi
}

linker_can_find_library() {
  local library="$1"
  local output_path

  if ! command -v cc >/dev/null 2>&1; then
    return 1
  fi

  output_path="$(mktemp "${TMPDIR:-/tmp}/avarch-link-test.XXXXXX")"
  rm -f "$output_path"
  if printf 'int main(void) { return 0; }\n' \
    | cc -x c - -o "$output_path" "-l$library" >/dev/null 2>&1; then
    rm -f "$output_path"
    return 0
  fi
  rm -f "$output_path"
  return 1
}

find_versioned_library() {
  local library="$1"
  local soname="lib${library}.so."
  local candidate
  local search_dirs=()
  local dir

  if command -v ldconfig >/dev/null 2>&1; then
    candidate="$(
      { ldconfig -p 2>/dev/null || true; } \
        | awk -v soname="$soname" '$1 ~ ("^" soname) { print $NF }' \
        | sort -V \
        | tail -n 1
    )"
    if [[ -n "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  for dir in /usr/lib /usr/lib64 /usr/local/lib /usr/local/lib64 /lib /lib64; do
    if [[ -d "$dir" ]]; then
      search_dirs+=("$dir")
    fi
  done
  if ((${#search_dirs[@]} == 0)); then
    return 1
  fi

  candidate="$(
    { find "${search_dirs[@]}" -maxdepth 2 \( -type f -o -type l \) \
      -name "${soname}*" -print 2>/dev/null || true; } \
      | sort -V \
      | tail -n 1
  )"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  return 1
}

find_bundled_vapoursynth_library() {
  local library="$1"
  local path
  local package_dir

  if ! command -v uv >/dev/null 2>&1; then
    return 1
  fi

  case "$library" in
    vapoursynth-script)
      if path="$(uv run vapoursynth get-vsscript 2>/dev/null)" && [[ -f "$path" ]]; then
        printf '%s\n' "$path"
        return 0
      fi
      ;;
    vapoursynth)
      package_dir="$(
        uv run python - <<'PY' 2>/dev/null || true
from pathlib import Path
import vapoursynth
print(Path(vapoursynth.__file__).parent)
PY
      )"
      if [[ -n "$package_dir" ]]; then
        path="$(
          find "$package_dir" -maxdepth 1 \( -type f -o -type l \) \
            -name 'libvapoursynth.so*' -print 2>/dev/null \
            | sort -V \
            | tail -n 1
        )"
        if [[ -n "$path" ]]; then
          printf '%s\n' "$path"
          return 0
        fi
      fi
      ;;
  esac

  return 1
}

prepare_vapoursynth_link_libraries() {
  local library
  local candidate
  local prepared=0
  local missing=()

  for library in vapoursynth vapoursynth-script; do
    if linker_can_find_library "$library"; then
      continue
    fi

    if candidate="$(find_bundled_vapoursynth_library "$library")" \
      || candidate="$(find_versioned_library "$library")"; then
      mkdir -p "$BOOTSTRAP_LIB_DIR"
      ln -sfn "$candidate" "$BOOTSTRAP_LIB_DIR/lib${library}.so"
      ln -sfn "$candidate" "$BOOTSTRAP_LIB_DIR/$(basename "$candidate")"
      prepared=1
      pass "link-lib" "lib${library}.so -> $candidate"
    else
      missing+=("lib${library}.so")
    fi
  done

  if ((${#missing[@]})); then
    printf '\nVapourSynth native libraries are not linkable: %s\n' "${missing[*]}" >&2
    cat >&2 <<'EOF'
Install the system VapourSynth runtime/development library, then rerun bootstrap.

If your distro only ships versioned files such as libvapoursynth.so.76,
bootstrap will create build-only symlinks under .avarch/bootstrap/lib
instead of requiring manual symlinks in a system library directory.
EOF
    return 1
  fi

  if (( prepared )); then
    prepend_colon_env_once LIBRARY_PATH "$BOOTSTRAP_LIB_DIR"
    prepend_colon_env_once LD_LIBRARY_PATH "$BOOTSTRAP_LIB_DIR"
  fi
}

write_vapoursynth_config_fallback() {
  AVARCH_BOOTSTRAP_LIB_DIR="$BOOTSTRAP_LIB_DIR" uv run python - <<'PY'
from __future__ import annotations

import json
import os
import sys
import sysconfig
import tomllib
from pathlib import Path

from vapoursynth._utils import (
    _get_vapoursynth_config_path,
    _mangle_vsscript_key,
    get_vsscript,
)


def candidate_python_libraries() -> list[Path]:
    names: list[str] = []
    version = f"{sys.version_info.major}.{sys.version_info.minor}"
    for key in ("INSTSONAME", "LDLIBRARY", "LIBRARY"):
        value = sysconfig.get_config_var(key)
        if value and ".so" in value:
            names.append(value)
    names.extend(
        [
            f"libpython{version}.so",
            f"libpython{version}.so.1.0",
            "libpython3.so",
        ]
    )

    dirs: list[Path] = []
    for key in ("LIBDIR", "LIBPL", "srcdir"):
        value = sysconfig.get_config_var(key)
        if value:
            dirs.append(Path(value))
    for root in (Path(sys.base_prefix), Path(sys.prefix), Path(sys.exec_prefix)):
        dirs.extend([root / "lib", root / "lib64"])

    candidates: list[Path] = []
    for directory in dirs:
        for name in names:
            candidates.append(directory / name)
    return candidates


python_library = next((path.resolve() for path in candidate_python_libraries() if path.is_file()), None)
if python_library is None:
    raise SystemExit("could not find a shared libpython for VapourSynth")

config_path = _get_vapoursynth_config_path()
try:
    contents = tomllib.loads(config_path.read_text(encoding="utf-8"))
except Exception:
    contents = {}

vsscript_paths = [Path(get_vsscript()).absolute()]
bootstrap_lib_dir = os.environ.get("AVARCH_BOOTSTRAP_LIB_DIR")
if bootstrap_lib_dir:
    bootstrap_lib_path = Path(bootstrap_lib_dir).absolute()
    vsscript_paths.extend(
        [
            bootstrap_lib_path / "libvsscript.so",
            bootstrap_lib_path / "libvapoursynth-script.so",
        ]
    )

for vsscript_path in vsscript_paths:
    contents[_mangle_vsscript_key(str(vsscript_path))] = [
        sys.executable,
        str(python_library),
    ]

config_path.write_text(
    "".join(
        f"{json.dumps(key)} = [{json.dumps(value[0])},{json.dumps(value[1])}]\n"
        for key, value in contents.items()
    ),
    encoding="utf-8",
)
print(config_path)
PY
}

configure_vapoursynth_runtime() {
  if command -v vapoursynth >/dev/null 2>&1; then
    vapoursynth config >/dev/null 2>&1 || true
    write_vapoursynth_config_fallback >/dev/null 2>&1 || true
    if vspipe --version >/dev/null 2>&1; then
      pass "vs-config" "VapourSynth runtime configured"
    else
      warn "vs-config" "vapoursynth config failed; vspipe may report the fix"
    fi
  fi
}

check_vspipe() {
  local executable="$1"

  if "$executable" --version >/dev/null 2>&1; then
    pass "vspipe" "$executable"
  else
    warn "vspipe" "found at $executable but --version failed"
    return 1
  fi
}

av1an_version_family() {
  local version_text="$1"
  if [[ "$version_text" =~ [Aa]v1an[^0-9]*([0-9]+)\.([0-9]+) ]]; then
    printf '%s.%s.x\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    return 0
  fi
  return 1
}

write_av1an_wrapper() {
  local real_av1an="$1"
  local wrapper="$BOOTSTRAP_BIN_DIR/av1an"

  mkdir -p "$BOOTSTRAP_BIN_DIR" "$ROOT_DIR/.venv/bin"
  cat >"$wrapper" <<EOF
#!/usr/bin/env bash
export LD_LIBRARY_PATH="$BOOTSTRAP_LIB_DIR:\${LD_LIBRARY_PATH:-}"
exec "$real_av1an" "\$@"
EOF
  chmod +x "$wrapper"
  ln -sfn "$wrapper" "$ROOT_DIR/.venv/bin/av1an"
  prepend_path_once "$ROOT_DIR/.venv/bin"
  prepend_path_once "$BOOTSTRAP_BIN_DIR"
}

check_av1an() {
  local executable="$1"
  local version_text
  local family

  if ! version_text="$("$executable" --version 2>&1)"; then
    warn "av1an" "found at $executable but --version failed"
    return 1
  fi

  if ! family="$(av1an_version_family "$version_text")"; then
    warn "av1an" "found at $executable but version could not be detected"
    return 1
  fi

  if [[ "$family" != "0.5.x" ]]; then
    warn "av1an" "found $family at $executable; avarch expects 0.5.x"
    return 1
  fi

  pass "av1an" "$executable ($family)"
}

install_av1an() {
  local output
  local cargo_bin
  local installed_av1an

  if ! command -v cargo >/dev/null 2>&1; then
    miss "av1an" "not on PATH and cargo is unavailable"
    return 1
  fi
  if ! command -v cc >/dev/null 2>&1; then
    miss "av1an" "not installed; C compiler/linker 'cc' is unavailable"
    return 1
  fi

  if ! prepare_vapoursynth_link_libraries; then
    miss "av1an" "not installed; VapourSynth native libraries need attention"
    return 1
  fi

  prepend_colon_env_once LIBRARY_PATH "$BOOTSTRAP_LIB_DIR"
  prepend_colon_env_once LD_LIBRARY_PATH "$BOOTSTRAP_LIB_DIR"
  printf 'Installing av1an %s with cargo...\n' "$AV1AN_VERSION_REQ"
  if ! output="$(cargo install av1an --version "$AV1AN_VERSION_REQ" --locked --force 2>&1)"; then
    printf '%s\n' "$output" >&2
    miss "av1an" "cargo install failed"
    return 1
  fi

  hash -r
  cargo_bin="$(dirname "$(command -v cargo)")"
  prepend_path_once "$HOME/.cargo/bin"
  prepend_path_once "$cargo_bin"
  installed_av1an="$cargo_bin/av1an"
  if [[ ! -x "$installed_av1an" && -x "$HOME/.cargo/bin/av1an" ]]; then
    installed_av1an="$HOME/.cargo/bin/av1an"
  fi
  if [[ -x "$installed_av1an" ]]; then
    write_av1an_wrapper "$installed_av1an"
    check_av1an "$ROOT_DIR/.venv/bin/av1an"
  else
    miss "av1an" "installed, but Cargo's bin directory was not found"
    return 1
  fi
}

prepend_path_once "$HOME/.cargo/bin"
prepend_path_once "$HOME/.local/bin"

if ! command -v uv >/dev/null 2>&1; then
  cat >&2 <<'EOF'
uv is required to run avarch.

Install uv, then rerun this script:
  curl -LsSf https://astral.sh/uv/install.sh | sh

After installing, open a new shell or source your shell profile so `uv` is on PATH.
EOF
  exit 1
fi

say "Syncing Python environment"
uv sync --locked --all-groups
prepend_path_once "$ROOT_DIR/.venv/bin"
configure_vapoursynth_runtime

say "Preparing avarch config and database"
if [[ -f "$CONFIG_PATH" ]]; then
  run_or_show_output uv run avarch db upgrade --config "$CONFIG_PATH"
else
  run_or_show_output uv run avarch init --config "$CONFIG_PATH"
fi
printf 'Config/database ready: %s\n' "$CONFIG_PATH"

say "Running avarch doctor"
run_or_show_output uv run avarch doctor --config "$CONFIG_PATH"
printf 'Doctor passed.\n'

say "Checking media toolchain"
missing_tools=0
for tool in ffprobe ffmpeg; do
  if command_path="$(command -v "$tool" 2>/dev/null)"; then
    pass "$tool" "$command_path"
  else
    missing_tools=1
    miss "$tool" "not on PATH"
  fi
done
if command_path="$(command -v vspipe 2>/dev/null)"; then
  if ! check_vspipe "$command_path"; then
    missing_tools=1
  fi
else
  missing_tools=1
  miss "vspipe" "not on PATH"
fi

if command_path="$(command -v av1an 2>/dev/null)"; then
  if ! check_av1an "$command_path"; then
    warn "av1an" "installing supported Cargo version for this project"
    install_av1an || missing_tools=1
  fi
else
  miss "av1an" "not on PATH"
  if ! install_av1an; then
    missing_tools=1
  fi
fi

if (( missing_tools )); then
  cat <<'EOF'

avarch itself is ready, but probing and encoding need the media toolchain:
  ffprobe   reads source metadata
  ffmpeg    muxes final outputs
  vspipe    validates/runs VapourSynth scripts
  av1an     performs AV1 chunked encoding

Install the missing system tools with your package manager. Bootstrap will try
to provide vspipe from the uv-managed VapourSynth package and install Av1an
0.5.x with cargo when cargo is available.
EOF
else
  printf '\nAll runtime tools were found.\n'
fi

cat <<EOF

Ready.
  Run the TUI:     uv run avarch tui --config "$CONFIG_PATH"
  Scan media:      uv run avarch scan /path/to/media --config "$CONFIG_PATH"
  List inventory:  uv run avarch files --config "$CONFIG_PATH"
EOF
