#!/usr/bin/env sh
set -eu

DEFAULT_IMAGE="${AVARCH_DEFAULT_IMAGE:-avarch:latest}"
IMAGE="${AVARCH_IMAGE:-$DEFAULT_IMAGE}"
CONTAINER_WORKSPACE="/workspace"
ENCODER_CONTAINER_NAME="avarch-encoder"
AVARCH_LABEL="org.avarch.container"
WORKSPACE_LABEL="org.avarch.workspace"

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

find_workspace() {
  current="${PWD:-$(pwd)}"
  while :; do
    if [ -f "$current/.avarch/workspace.toml" ]; then
      printf '%s\n' "$current"
      return 0
    fi
    parent=$(dirname "$current")
    if [ "$parent" = "$current" ]; then
      return 1
    fi
    current="$parent"
  done
}

workspace_required() {
  case "${1:-}" in
    "" | "-h" | "--help" | "--version" | "version" | "init")
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

volume_options() {
  if [ "${AVARCH_DOCKER_VOLUME_OPTIONS+x}" = "x" ]; then
    printf '%s\n' "$AVARCH_DOCKER_VOLUME_OPTIONS"
    return 0
  fi

  printf '%s\n' ""
}

selinux_enabled() {
  if [ -r /sys/fs/selinux/enforce ]; then
    read -r enforcing < /sys/fs/selinux/enforce || enforcing=0
    if [ "$enforcing" = "1" ]; then
      return 0
    fi
  fi

  if command -v ls >/dev/null 2>&1; then
    selinux_context=$(ls -Zd "$1" 2>/dev/null || true)
    case "$selinux_context" in
      *:object_r:*)
        return 0
        ;;
    esac
  fi

  return 1
}

docker_run_args() {
  printf '%s' "run --rm --user $uid:$gid"
  if [ "${AVARCH_DOCKER_SECURITY_OPT+x}" = "x" ]; then
    if [ -n "$AVARCH_DOCKER_SECURITY_OPT" ]; then
      printf ' %s %s' "--security-opt" "$AVARCH_DOCKER_SECURITY_OPT"
    fi
  elif [ -n "${workspace:-}" ] && selinux_enabled "$workspace"; then
    printf ' %s %s' "--security-opt" "label=disable"
  fi
}

workspace_volume() {
  options=$(volume_options "$1")
  if [ -n "$options" ]; then
    printf '%s:%s:%s\n' "$1" "$CONTAINER_WORKSPACE" "$options"
  else
    printf '%s:%s\n' "$1" "$CONTAINER_WORKSPACE"
  fi
}

uid=$(id -u)
gid=$(id -g)

set -- "$@"
workspace=""
if workspace=$(find_workspace); then
  docker_args="$(docker_run_args) -v $(workspace_volume "$workspace") -w $CONTAINER_WORKSPACE"
elif workspace_required "${1:-}"; then
  die "No Avarch workspace found. Run 'avarch init' from the workspace root."
else
  workspace="${PWD:-$(pwd)}"
  docker_args="$(docker_run_args)"
  if [ "${1:-}" = "init" ]; then
    if [ ! -w "$workspace" ]; then
      die "Workspace root is not writable: $workspace"
    fi
    docker_args="$docker_args -v $(workspace_volume "$workspace") -w $CONTAINER_WORKSPACE"
  fi
fi

if [ "${1:-}" = "scheduler" ] && [ "${2:-}" = "run" ]; then
  existing=$(docker ps -aq --filter "name=^/${ENCODER_CONTAINER_NAME}$" | head -n 1 || true)
  if [ -n "$existing" ]; then
    inspected=$(docker inspect \
      --format "{{.State.Running}}	{{index .Config.Labels \"$AVARCH_LABEL\"}}	{{index .Config.Labels \"$WORKSPACE_LABEL\"}}" \
      "$existing" 2>/dev/null || true)
    running=$(printf '%s' "$inspected" | cut -f1)
    avarch_kind=$(printf '%s' "$inspected" | cut -f2)
    owner_workspace=$(printf '%s' "$inspected" | cut -f3)

    if [ "$running" = "true" ]; then
      if [ "$avarch_kind" = "encoder" ]; then
        die "Avarch scheduler is already running in container ${ENCODER_CONTAINER_NAME} for workspace: ${owner_workspace:-unknown}"
      fi
      die "Container name ${ENCODER_CONTAINER_NAME} is already in use by a non-Avarch container."
    fi

    if [ "$avarch_kind" = "encoder" ]; then
      docker rm "$existing" >/dev/null
    else
      die "Container name ${ENCODER_CONTAINER_NAME} is already in use by a non-Avarch container."
    fi
  fi

  docker_args="$docker_args --name $ENCODER_CONTAINER_NAME --label $AVARCH_LABEL=encoder --label $WORKSPACE_LABEL=$workspace"
fi

exec docker $docker_args "$IMAGE" "$@"
